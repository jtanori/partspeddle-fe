# Application
APP_URL="https://your-app.example.com"

# Supabase Configuration
# Server-side / Edge Function credentials
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Client-side Supabase credentials (used by browser bundle)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Algolia Configuration
ALGOLIA_APP_ID="YOUR_ALGOLIA_APP_ID"
ALGOLIA_ADMIN_KEY="YOUR_ALGOLIA_ADMIN_KEY"
# Optional: override default index names
# ALGOLIA_SEARCH_INDEX_NAME="parts"
# ALGOLIA_INDEX_PRICE_ASC="parts_price_asc"
# ALGOLIA_INDEX_PRICE_DESC="parts_price_desc"
# ALGOLIA_INDEX_NEWEST="parts_newest"

# Gemini AI
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Webhook security (used by supabase/functions/sync-algolia-webhook)
SUPABASE_WEBHOOK_SECRET="your-webhook-secret"
