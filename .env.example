# =============================================================================
# Environment Variable Reference
# =============================================================================
# Classify every variable before adding it:
#   - NEXT_PUBLIC_* : shipped to the browser; must never contain secrets.
#   - Server-only   : used by Next.js server / API routes / Edge Functions.
#   - CI/Deploy-only: used by GitHub Actions, Fly.io deploy, or Supabase CLI.
# =============================================================================

# Application (server-only)
APP_URL="https://your-app.example.com"

# ---------------------------------------------------------------------------
# Supabase (server-only)
# ---------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------------
# Supabase (browser-safe; NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ---------------------------------------------------------------------------
# Algolia (server-only admin key; do NOT use NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
ALGOLIA_APP_ID="YOUR_ALGOLIA_APP_ID"
ALGOLIA_ADMIN_KEY="YOUR_ALGOLIA_ADMIN_KEY"
# Optional: override default index names
# ALGOLIA_SEARCH_INDEX_NAME="parts"
# ALGOLIA_INDEX_PRICE_ASC="parts_price_asc"
# ALGOLIA_INDEX_PRICE_DESC="parts_price_desc"
# ALGOLIA_INDEX_NEWEST="parts_newest"

# ---------------------------------------------------------------------------
# Gemini AI (server-only)
# ---------------------------------------------------------------------------
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# Webhook security (server-only / Edge Function)
# Used by supabase/functions/sync-algolia-webhook
# ---------------------------------------------------------------------------
SUPABASE_WEBHOOK_SECRET="your-webhook-secret"
