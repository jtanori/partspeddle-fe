{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/domain scripts",
    "clean": "rm -rf .next dist",
    "deps:restore": "bash scripts/restore-deps.sh",
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run tests/c0_8 tests/certification",
    "db:seed": "tsx src/services/seed-runner.ts",
    "db:seed:users": "tsx scripts/seed-users.ts",
    "db:seed:listings": "tsx scripts/seed-listings.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:seed:production": "tsx scripts/seed-production.ts",
    "algolia:config": "tsx scripts/algolia/configure-algolia-index.ts",
    "search:reindex": "tsx scripts/algolia/reindex-algolia.ts",
    "search:process-outbox": "tsx scripts/process-search-outbox.ts",
    "audit:search-platform": "tsx scripts/audit-search-consistency.ts && tsx scripts/audit-worker-health.ts",
    "test:outbox-recovery": "tsx scripts/test-outbox-recovery.ts",
    "test:load": "k6 run --out json=reports/load-test-report.json",
    "scgs:compile": "tsx ./scripts/scgs/compile.ts",
    "scgs:evaluate": "tsx ./scripts/scgs/evaluate.ts",
    "scgs:snapshot:load": "tsx ./scripts/scgs/snapshot-load.ts",
    "scgs:diff": "node ./scripts/scgs/diff.js",
    "scgs:pts:compute": "node ./scripts/scgs/pts.js",
    "scgs:ci:decide": "node ./scripts/scgs/ci-decide.js",
    "scgs:ci:enforce": "node ./scripts/scgs/ci-enforce.js",
    "scgs:replay:validate": "tsx ./scripts/scgs/replay-validate.ts",
    "scgs:search:parity": "tsx ./scripts/scgs/search-parity.ts",
    "scgs:ranking:audit": "tsx ./scripts/scgs/ranking-signal-audit.ts",
    "scgs:search:investigate": "tsx ./scripts/scgs/search-ranking-investigate.ts",
    "scgs:prr": "tsx ./scripts/scgs/prr.ts",
    "verify:schema": "tsx scripts/verify-schema.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@google/genai": "^2.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-prometheus": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@vitejs/plugin-react": "^5.0.4",
    "algoliasearch": "^5.53.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.25",
    "@types/next": "^8.0.7",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
