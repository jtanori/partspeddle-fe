# Supabase project credentials used by all Edge Functions.
# When running locally, copy the values printed by `supabase status` (or `pnpm db:local:status`).
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Algolia credentials used by sync-algolia-webhook.
ALGOLIA_APP_ID=YOUR_ALGOLIA_APP_ID
ALGOLIA_ADMIN_KEY=YOUR_ALGOLIA_ADMIN_KEY

# Webhook signature secret used to verify Supabase database webhook calls.
SUPABASE_WEBHOOK_SECRET=your-webhook-secret

# Gemini API key used by analyze-part-image.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
