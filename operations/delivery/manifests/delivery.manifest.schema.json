{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://partspeddle.com/schemas/delivery.manifest.json",
  "title": "Delivery Manifest",
  "description": "Canonical descriptor for the PartsPeddle delivery platform.",
  "type": "object",
  "required": [
    "version",
    "project",
    "environments",
    "deployment",
    "verification",
    "observability",
    "recovery",
    "certification"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "project": { "type": "string" },
    "description": { "type": "string" },
    "environments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "appUrl", "flyApp", "githubEnvironment", "healthEndpoint"],
        "properties": {
          "name": { "type": "string" },
          "appUrl": { "type": "string", "format": "uri" },
          "flyApp": { "type": "string" },
          "githubEnvironment": { "type": "string" },
          "supabaseProjectIdSecret": { "type": "string" },
          "healthEndpoint": { "type": "string" }
        }
      }
    },
    "deployment": {
      "type": "object",
      "required": ["topology", "rollbackStrategy", "healthEndpoint"],
      "properties": {
        "topology": { "type": "array", "items": { "type": "string" } },
        "rollbackStrategy": { "type": "string" },
        "healthEndpoint": { "type": "string" },
        "requiredSecretsProvider": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verification": {
      "type": "object",
      "required": ["sequence", "requiredHealthChecks", "postDeployChecks"],
      "properties": {
        "sequence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "command"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "command": { "type": "string" }
            }
          }
        },
        "requiredHealthChecks": { "type": "array", "items": { "type": "string" } },
        "postDeployChecks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "observability": {
      "type": "object",
      "required": ["deploymentRecordsDir", "requiredMetadata"],
      "properties": {
        "deploymentRecordsDir": { "type": "string" },
        "requiredMetadata": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["runbookPath", "rollbackCommands", "healthCheckCommands"],
      "properties": {
        "runbookPath": { "type": "string" },
        "rollbackCommands": { "type": "object", "additionalProperties": { "type": "string" } },
        "healthCheckCommands": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "certification": {
      "type": "object",
      "required": ["gates", "blockingGatesForProduction"],
      "properties": {
        "gates": { "type": "array", "items": { "type": "string" } },
        "blockingGatesForProduction": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
