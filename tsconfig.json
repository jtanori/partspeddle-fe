{
  "extends": "./packages/config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@config/*": ["./config/*"],
      "@operations/*": ["./platform/operations/*"]
    }
  },
  "include": ["platform/scripts", "platform/operations", "apps/web/src", "config/environment"],
  "exclude": ["supabase", "node_modules", "platform/scripts/archive", "apps/web/.next", "packages", ".next"]
}
